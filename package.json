{
  "name": "wikibricks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "npm run typecheck && vite build --ssr && vite build",
    "dev": "vite build && concurrently --kill-others --names server,client npm:dev:server npm:dev:client",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "vite build --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p src/client/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@hono/node-server": "^2.1.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "hono": "^4.13.16",
    "postgres": "^4.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
