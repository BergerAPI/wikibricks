{
  "name": "my-app",
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "npx tailwindcss -i ./global.css -o ./public/styles.css --minify",
    "dev": "npm run build:css && tsx watch src/index.ts",
    "dev:css": "npx tailwindcss -i ./global.css -o ./public/styles.css --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.929.0",
    "@aws-sdk/s3-request-presigner": "^3.929.0",
    "@hono/node-server": "^1.13.7",
    "@tailwindcss/cli": "^4.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.17",
    "postgres": "^3.4.5",
    "tailwindcss": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
