{
  "name": "wikibricks",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "tailwindcss -i ./global.css -o ./dist/public/styles.css --minify",
    "dev": "npm run build:css && tsx watch src/index.ts",
    "dev:css": "tailwindcss -i ./global.css -o ./dist/public/styles.css --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.929.0",
    "@aws-sdk/s3-request-presigner": "^3.929.0",
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.17",
    "postgres": "^3.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^20.11.17",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
