{
  "name": "wikibricks",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc && tsc -p src/client/tsconfig.json && npm run build:css && npm run build:client -- --minify --metafile=dist/client-outputs.json && node dist/build-assets.js",
    "build:css": "tailwindcss -i ./global.css -o ./dist/public/styles.css --minify",
    "build:client": "esbuild \"src/client/pages/*.ts\" --bundle --platform=browser --format=esm --target=es2021 --outdir=dist/public",
    "dev": "npm run build:css && npm run build:client -- --sourcemap=inline && concurrently --kill-others --names server,css,client npm:dev:server npm:dev:css npm:dev:client",
    "dev:server": "tsx watch src/index.ts",
    "dev:css": "tailwindcss -i ./global.css -o ./dist/public/styles.css --watch=always",
    "start": "node dist/index.js",
    "publish:assets": "node dist/publish-assets.js",
    "dev:client": "npm run build:client -- --sourcemap=inline --watch=forever",
    "typecheck": "tsc --noEmit && tsc -p src/client/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.929.0",
    "@aws-sdk/s3-request-presigner": "^3.929.0",
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.17",
    "postgres": "^3.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^20.11.17",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
