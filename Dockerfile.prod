FROM node:26-alpine AS builder
WORKDIR /app

# The workspace packages are needed for npm ci to link them
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci

COPY . .
# The server serves public/ if it exists
RUN npm run build && mkdir -p public

FROM node:26-alpine AS runner
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist dist
COPY --from=builder /app/public public

# Uploads and the assets shared between releases are written by the unprivileged app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S appuser -u 1001 -G nodejs && \
    mkdir -p /app/data /app/shared-assets/files && \
    chown -R appuser:nodejs /app
USER appuser

# Shown in the footer, so pages can be traced back to the commit they were built from
ARG COMMIT_ID=unknown
ENV NODE_ENV=production \
    COMMIT_ID=${COMMIT_ID} \
    UPLOAD_DIR=/app/data

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

CMD ["node", "dist/index.js"]
