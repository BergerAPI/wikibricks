# Database Configuration
DB_CONN=postgresql://wikibricks_user:wikibricks_password@localhost:5432/wikibricks

# PostgreSQL Configuration (for docker-compose)
POSTGRES_USER=wikibricks_user
POSTGRES_PASSWORD=wikibricks_password
POSTGRES_DB=wikibricks

# Application Configuration
NODE_ENV=development
PORT=3000
UPLOAD_DIR=uploads/images
COMMIT_ID=unknown

# JWT Secret (generate a secure random string for production, min 32 chars)
# e.g. openssl rand -hex 32
JWT_SECRET=
# Set only when a trusted reverse proxy sets X-Forwarded-For.
TRUSTED_PROXY_IP=
GITHUB_URL=https://github.com/BergerAPI/wikibricks
