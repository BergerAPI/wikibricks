# One file for development and production. Copy it to .env and fill in what you need.
# For development nothing is required: npm run dev starts a local database with sample data.

# Database. Leave unset in development to use the local database.
# DB_CONN=postgresql://wikibricks_user:wikibricks_password@localhost:5432/wikibricks

# Port of the app
PORT=3000

# Where uploaded images are stored
UPLOAD_DIR=uploads/images

# Signs the login cookies. Required in production, at least 32 characters:
# openssl rand -hex 32
JWT_SECRET=

# Production only (docker-compose.prod.yml)
POSTGRES_USER=wikibricks_user
POSTGRES_PASSWORD=
# Set only when a trusted reverse proxy sets X-Forwarded-For
TRUSTED_PROXY_IP=
GITHUB_URL=https://github.com/BergerAPI/wikibricks
