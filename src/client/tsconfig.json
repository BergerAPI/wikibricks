{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["vite/client"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "../components/**/script.ts",
    "../shared/**/*.ts"
  ],
  "exclude": []
}
